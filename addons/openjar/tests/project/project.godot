; Test harness for openjar-addons. tests/.gdignore keeps the whole tests/ folder out of a
; consuming game; tests/run.sh links the repo root in as res://addons/openjar and a local
; gdUnit4 as res://addons/gdUnit4 (both gitignored).
config_version=5

[application]

config/name="openjar-addons tests"
config/features=PackedStringArray("4.7")

[autoload]

Shots="*res://tools/shots.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=0
